<odoo>
<data>
<!--  Receipt Form View  -->
<record id="receipt_form" model="ir.ui.view">
<field name="name">Receipt Form</field>
<field name="model">stocksense.receipt</field>
<field name="arch" type="xml">
<form string="Stock Receipt">
<header>
<button name="action_confirm" string="Confirm" type="object" class="oe_highlight" states="draft"/>
<button name="action_done" string="Validate" type="object" class="oe_highlight" states="confirmed"/>
<button name="action_cancel" string="Cancel" type="object" states="draft,confirmed"/>
<button name="action_reset" string="Reset to Draft" type="object" states="canceled"/>
<field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
</header>
<sheet>
<div class="oe_title">
<h1>
<field name="name" readonly="1"/>
</h1>
</div>
<group>
<group>
<field name="receipt_date"/>
<field name="supplier_id" string="Supplier"/>
<field name="user_id" readonly="1"/>
</group>
<group>
<field name="warehouse_id"/>
<field name="location_id"/>
<field name="total_items" readonly="1"/>
</group>
</group>
<notebook>
<page string="Receipt Lines">
<field name="receipt_line_ids" mode="tree,form">
<tree>
<field name="product_id"/>
<field name="quantity"/>
<field name="uom_id"/>
</tree>
<form>
<group>
<field name="product_id"/>
<field name="quantity"/>
<field name="uom_id"/>
<field name="notes"/>
</group>
</form>
</field>
</page>
<page string="Notes">
<field name="notes" placeholder="Additional notes..."/>
</page>
</notebook>
</sheet>
</form>
</field>
</record>
<!--  Receipt Tree View  -->
<record id="receipt_tree" model="ir.ui.view">
<field name="name">Receipt Tree</field>
<field name="model">stocksense.receipt</field>
<field name="arch" type="xml">
<tree string="Stock Receipts">
<field name="name"/>
<field name="receipt_date"/>
<field name="supplier_id"/>
<field name="warehouse_id"/>
<field name="total_items"/>
<field name="state" widget="badge"/>
</tree>
</field>
</record>
<!--  Receipt Search View  -->
<record id="receipt_search" model="ir.ui.view">
<field name="name">Receipt Search</field>
<field name="model">stocksense.receipt</field>
<field name="arch" type="xml">
<search string="Stock Receipts">
<field name="name" string="Receipt Number"/>
<field name="supplier_id"/>
<field name="warehouse_id"/>
<separator/>
<filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
<filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
<filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
<filter string="Canceled" name="canceled" domain="[('state', '=', 'canceled')]"/>
<separator/>
<filter string="Today" name="today" domain="[('receipt_date', '>=', context_today().strftime('%Y-%m-%d')), ('receipt_date', '<', (context_today() + timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
<group expand="0" string="Group By">
<filter string="State" name="state" context="{'group_by': 'state'}"/>
<filter string="Supplier" name="supplier" context="{'group_by': 'supplier_id'}"/>
<filter string="Warehouse" name="warehouse" context="{'group_by': 'warehouse_id'}"/>
</group>
</search>
</field>
</record>
<!--  Receipt Line Form (for nested form)  -->
<record id="receipt_line_form" model="ir.ui.view">
<field name="name">Receipt Line Form</field>
<field name="model">stocksense.receipt.line</field>
<field name="arch" type="xml">
<form string="Receipt Line">
<group>
<field name="product_id"/>
<field name="quantity"/>
<field name="uom_id"/>
<field name="notes" placeholder="Notes..."/>
</group>
</form>
</field>
</record>
</data>
</odoo>