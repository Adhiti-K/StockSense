<odoo>
<data>
<!--  ACTIONS  -->
<!--  Receipt Actions  -->
<record id="action_receipt_list" model="ir.actions.act_window">
<field name="name">Stock Receipts</field>
<field name="res_model">stocksense.receipt</field>
<field name="view_mode">tree,form</field>
<field name="context">{}</field>
<field name="help" type="html">
<p class="o_view_nocontent_smiling_face"> Create a new stock receipt </p>
<p> Record incoming goods from suppliers. Each receipt will increase stock quantity. </p>
</field>
</record>
<!--  Delivery Actions  -->
<record id="action_delivery_list" model="ir.actions.act_window">
<field name="name">Stock Deliveries</field>
<field name="res_model">stocksense.delivery</field>
<field name="view_mode">tree,form</field>
<field name="context">{}</field>
<field name="help" type="html">
<p class="o_view_nocontent_smiling_face"> Create a new stock delivery </p>
<p> Record outgoing goods to customers. Each delivery will decrease stock quantity. </p>
</field>
</record>
<!--  Transfer Actions  -->
<record id="action_transfer_list" model="ir.actions.act_window">
<field name="name">Internal Transfers</field>
<field name="res_model">stocksense.transfer</field>
<field name="view_mode">tree,form</field>
<field name="context">{}</field>
<field name="help" type="html">
<p class="o_view_nocontent_smiling_face"> Create a new internal transfer </p>
<p> Move stock between warehouse locations. Total stock remains unchanged. </p>
</field>
</record>
<!--  Adjustment Actions  -->
<record id="action_adjustment_list" model="ir.actions.act_window">
<field name="name">Stock Adjustments</field>
<field name="res_model">stocksense.adjustment</field>
<field name="view_mode">tree,form</field>
<field name="context">{}</field>
<field name="help" type="html">
<p class="o_view_nocontent_smiling_face"> Create a new stock adjustment </p>
<p> Reconcile physical stock with recorded quantities. </p>
</field>
</record>
<!--  Ledger Actions  -->
<record id="action_ledger_list" model="ir.actions.act_window">
<field name="name">Stock Ledger</field>
<field name="res_model">stocksense.ledger</field>
<field name="view_mode">tree,form</field>
<field name="context">{}</field>
<field name="help" type="html">
<p class="o_view_nocontent_smiling_face"> View stock movement history </p>
<p> Complete audit trail of all inventory movements. </p>
</field>
</record>
<!--  Product Actions  -->
<record id="action_product_list" model="ir.actions.act_window">
<field name="name">Products</field>
<field name="res_model">product.product</field>
<field name="view_mode">tree,form</field>
<field name="context">{'search_default_in_stock': True}</field>
<field name="help" type="html">
<p class="o_view_nocontent_smiling_face"> Create a new product </p>
<p> Manage your inventory products. </p>
</field>
</record>
<!--  Product Category Actions  -->
<record id="action_product_category_list" model="ir.actions.act_window">
<field name="name">Product Categories</field>
<field name="res_model">stocksense.product.category</field>
<field name="view_mode">tree,form</field>
<field name="help" type="html">
<p class="o_view_nocontent_smiling_face"> Create a new product category </p>
</field>
</record>
<!--  MENUS  -->
<!--  Main StockSense Menu  -->
<menuitem id="menu_stocksense_root" name="StockSense" icon="fa-cubes" sequence="10"/>
<!--  Dashboard Submenu  -->
<menuitem id="menu_dashboard" name="Dashboard" parent="menu_stocksense_root" sequence="10" action="stock.action_stock_level_forecast_report_tree"/>
<!--  Inventory Operations Menu  -->
<menuitem id="menu_inventory_ops" name="Inventory Operations" parent="menu_stocksense_root" sequence="20"/>
<menuitem id="menu_receipt" name="Receipts" parent="menu_inventory_ops" sequence="10" action="action_receipt_list"/>
<menuitem id="menu_delivery" name="Deliveries" parent="menu_inventory_ops" sequence="20" action="action_delivery_list"/>
<menuitem id="menu_transfer" name="Internal Transfers" parent="menu_inventory_ops" sequence="30" action="action_transfer_list"/>
<menuitem id="menu_adjustment" name="Stock Adjustments" parent="menu_inventory_ops" sequence="40" action="action_adjustment_list"/>
<!--  Reports & Analysis Menu  -->
<menuitem id="menu_reports" name="Reports" parent="menu_stocksense_root" sequence="30"/>
<menuitem id="menu_ledger" name="Stock Ledger" parent="menu_reports" sequence="10" action="action_ledger_list"/>
<!--  Products & Categories Menu  -->
<menuitem id="menu_products" name="Products" parent="menu_stocksense_root" sequence="40"/>
<menuitem id="menu_product_list" name="All Products" parent="menu_products" sequence="10" action="action_product_list"/>
<menuitem id="menu_product_categories" name="Product Categories" parent="menu_products" sequence="20" action="action_product_category_list"/>
<!--  Configuration Menu  -->
<menuitem id="menu_config" name="Configuration" parent="menu_stocksense_root" sequence="50"/>
<menuitem id="menu_config_warehouse" name="Warehouses" parent="menu_config" sequence="10" action="stock.action_warehouse_form"/>
</data>
</odoo>